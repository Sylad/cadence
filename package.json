{
  "name": "@sylad/cadence",
  "version": "1.28.0",
  "description": "A small, repo-native working method: a versioned plan linked to your commits, a changelog with screenshots, session rituals and deliveries proven by their effect.",
  "license": "MIT",
  "author": "Sylvain Ladoire",
  "type": "module",
  "bin": {
    "raf": "bin/raf.js",
    "cadence": "bin/cadence.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "agents",
    "templates",
    ".claude-plugin",
    "README.md",
    "docs/raf.md",
    "docs/orchestrate.md",
    "docs/deliver.md",
    "docs/spec.md",
    "docs/lead.md",
    "docs/ref.md",
    "docs/stabilite.md",
    "docs/news.md",
    "docs/session.md",
    "docs/corrections.md",
    "docs/perf.md",
    "docs/skills.md",
    "docs/cadence-hud.md",
    "docs/releasing.md",
    "docs/overview.md",
    "docs/whats-new.md",
    "docs/fonctionnement.md",
    "docs/fonctionnement-lot-light.svg",
    "docs/fonctionnement-lot-dark.svg",
    "docs/fonctionnement-wave-light.svg",
    "docs/fonctionnement-wave-dark.svg",
    "docs/fonctionnement-service-light.svg",
    "docs/fonctionnement-service-dark.svg",
    "docs/fonctionnement-lead-light.svg",
    "docs/fonctionnement-lead-dark.svg",
    "docs/lead-workflow-light.svg",
    "docs/lead-workflow-dark.svg",
    "docs/quickstart.md",
    "docs/quickstart-light.svg",
    "docs/quickstart-dark.svg",
    "docs/with-your-tools.md",
    "docs/with-your-tools-light.svg",
    "docs/with-your-tools-dark.svg",
    "docs/cycle-vague-light.svg",
    "docs/cycle-vague-dark.svg",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit",
    "service": "node scripts/mise-en-service.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:plugin": "claude plugin eval . --max-cost-usd 5 --no-publish",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sylad/cadence.git"
  }
}
